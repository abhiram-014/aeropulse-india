# Air Quality Insight Platform - Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
DATA_MODE=demo # Options: 'demo' | 'live'

# External APIs (Optional for live mode)
# OpenAQ API v2/v3 (Free tier / API Key if required)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v2

# Open-Meteo (Free, No Key Required for non-commercial)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# CPCB / Data.gov.in API (Optional)
DATA_GOV_IN_API_KEY=

# ML Prediction Service
ML_SERVICE_URL=http://localhost:8000
ML_FALLBACK_ENABLED=true

# Database (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/air_quality_db
USE_SQLITE_FALLBACK=true

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
