# ============================================================
# AeroPulse India — Environment Variables Reference
# Copy this file to .env and fill in real values locally.
# NEVER commit .env with real secrets.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
DATA_MODE=demo
# DATA_MODE=live   ← enables OpenAQ live telemetry

# ── CORS ─────────────────────────────────────────────────────
# Set to your Render Static Site URL in production
# e.g. https://aeropulse-india.onrender.com
CORS_ORIGIN=http://localhost:5173

# ── OpenAQ (optional — for DATA_MODE=live) ───────────────────
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# ── Open-Meteo (free, no key required) ───────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── AI Assistant (optional) ──────────────────────────────────
# Used by backend AiAssistantService. Never expose to frontend.
AI_API_KEY=
GEMINI_API_KEY=

# ── ML Prediction Service ─────────────────────────────────────
# In production: set to your Render ML service URL
# e.g. https://aeropulse-ml.onrender.com
# If unset or unreachable, backend falls back to embedded model automatically.
ML_SERVICE_URL=http://localhost:8000
ML_FALLBACK_ENABLED=true

# ── Database (NOT currently required) ────────────────────────
# The backend currently runs on demo/OpenAQ data.
# Schema exists for future use. Leave blank unless enabling DB features.
DATABASE_URL=
USE_SQLITE_FALLBACK=false

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
